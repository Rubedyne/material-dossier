  "statements": [
    {
      "id": "s-desc",
      "as_of": "2026-03",
      "kind": "description",
      "text": {
        "en": "Exahydrate L30 is a preserved aqueous solution of three natural moisturising factors for leave-on and rinse-off skin care."
      }
    },
    {
      "id": "s-benefit",
      "as_of": "2026-03",
      "kind": "benefit",
      "text": {
        "en": "Builds up skin hydration over four weeks of use."
      },
      "supports": [
        "eff-hydration",
        "ds-hydration"
      ]
    },
    {
      "id": "s-claim",
      "as_of": "2026-03",
      "kind": "claim",
      "text": {
        "en": "Up to 24 % more skin hydration than placebo after 28 days (3 % in an O/W cream, n = 24)."
      },
      "supports": [
        "eff-hydration"
      ]
    },
    {
      "id": "s-guid-1",
      "as_of": "2026-03",
      "kind": "guidance",
      "text": {
        "en": "Add below 40 Cel during cool-down, or dissolve in the water phase when the process stays below 60 Cel."
      }
    },
    {
      "id": "s-guid-2",
      "as_of": "2026-03",
      "kind": "guidance",
      "text": {
        "en": "In carbomer gels expect a viscosity loss; compensate with a higher polymer level."
      }
    },
    {
      "id": "s-check-1",
      "as_of": "2026-03",
      "kind": "checklist",
      "text": {
        "en": "If a carbomer is present, is its level raised or an electrolyte-tolerant thickener added?"
      }
    },
    {
      "id": "s-storage",
      "as_of": "2026-03",
      "kind": "storage",
      "text": {
        "en": "Store closed at 5 to 25 Cel. Use within three months after opening."
      }
    },
    {
      "id": "s-disclaimer",
      "as_of": "2026-03",
      "kind": "disclaimer",
      "text": {
        "en": "Study results describe the test formulation named with each result; they do not substantiate claims for any other product."
      }
    }
  ],
