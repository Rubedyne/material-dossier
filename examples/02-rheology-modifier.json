          "function": "emollient"
        },
        {
          "phase": "B",
          "inci": "Tocopheryl Acetate",
          "percent": 0.5,
          "function": "antioxidant"
        },
        {
          "phase": "C",
          "inci": "Sodium Hydroxide",
          "percent": 0.16,
          "function": "buffering"
        },
        {
          "phase": "D",
          "inci": "Phenoxyethanol",
          "percent": 0.9,
          "function": "preservative"
        },
        {
          "phase": "D",
          "inci": "Ethylhexylglycerin",
          "percent": 0.1,
          "function": "skin_conditioning"
        }
      ],
      "procedure": [
        {
          "en": "Sprinkle Exagel R200 onto the water of phase A while stirring; let it hydrate for 20 to 30 minutes, then add the rest of phase A."
        },
        {
          "en": "Heat A and B separately to 70 Cel. Add B to A under homogenization for 2 minutes."
        },
        {
          "en": "Neutralize with phase C to pH 6.0 to 6.5 under slow stirring."
        },
        {
          "en": "Cool to below 40 Cel and add phase D."
        }
      ]
    }
