  "statements": [
    {
      "id": "s-desc",
      "as_of": "2026-05",
      "kind": "description",
      "text": {
        "en": "Exagel R200 is a cross-linked acrylic polymer that gives clear, shear-thinning gels and stabilizes emulsions at low use levels."
      }
    },
    {
      "id": "s-guid-1",
      "as_of": "2026-05",
      "kind": "guidance",
      "text": {
        "en": "Disperse into the water phase before any electrolyte or neutralizer is added; allow 20 to 30 minutes to hydrate."
      }
    },
    {
      "id": "s-guid-2",
      "as_of": "2026-05",
      "kind": "guidance",
      "text": {
        "en": "Neutralize to pH 5.5 to 7.5 to develop viscosity; below pH 5 the gel stays thin."
      }
    },
    {
      "id": "s-check-1",
      "as_of": "2026-05",
      "kind": "checklist",
      "text": {
        "en": "Is a neutralizer (for example sodium hydroxide or an amine) present in the formula?"
      }
    },
    {
      "id": "s-check-2",
      "as_of": "2026-05",
      "kind": "checklist",
      "text": {
        "en": "Are cationic surfactants or cationic polymers absent?"
      }
    },
    {
      "id": "s-handling",
      "as_of": "2026-05",
      "kind": "handling",
      "text": {
        "en": "Avoid dust formation when weighing; the powder is hygroscopic, close containers after use."
      }
    }
  ],
