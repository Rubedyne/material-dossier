      "id": "s-desc",
      "as_of": "2026-06",
      "kind": "description",
      "text": {
        "en": "Exasol UV-T is an oil-soluble broad-spectrum UV filter with high photostability."
      }
    },
    {
      "id": "s-disclaimer",
      "as_of": "2026-06",
      "kind": "disclaimer",
      "text": {
        "en": "SPF, UVA-PF, critical wavelength and water-resistance values describe the named test formulations only. They are not properties of the raw material and must not be used as claims for any other product; every sunscreen product needs its own tests."
      }
    },
    {
      "id": "s-guid-1",
      "as_of": "2026-06",
      "kind": "guidance",
      "text": {
        "en": "Dissolve completely in the heated oil phase (75 to 85 Cel) with polar emollients before emulsifying."
      }
    },
    {
      "id": "s-check-1",
      "as_of": "2026-06",
      "kind": "checklist",
      "text": {
        "en": "Does the oil phase contain enough polar emollient to keep the filter dissolved (about 8 parts per part of filter)?"
      }
    }
