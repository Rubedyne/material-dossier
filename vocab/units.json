{
  "vocab": "units",
  "vocab_version": "1.0",
  "issued": "2026-11-23",
  "title": "Dimensions, canonical UCUM units and accepted units",
  "license": "Apache-2.0",
  "source": "Unit codes are UCUM case-sensitive codes (https://ucum.org). Curly-brace annotations are UCUM annotations.",
  "note": "`units` maps each accepted unit to the factor that converts a value to the canonical unit (canonical = value x factor); null means accepted but not convertible, the consumer keeps it as written. `aliases` lists lower-case spellings that the deterministic evidence check accepts as the unit in a source quote.",
  "aliases": {"%": ["%", "percent", "wt%", "w/w", "pct"], "[ppm]": ["ppm"], "[ppb]": ["ppb"], "mg/kg": ["mg/kg", "ppm"], "[pH]": ["ph"], "Cel": ["°c", "° c", "deg c", "celsius", "ºc", "c°", "deg. c", "degree c", "degrees c"], "mPa.s": ["mpa.s", "mpa·s", "mpas", "mpa s", "mpa*s", "mpa∙s"], "cP": ["cp", "cps", "centipoise"], "Pa.s": ["pa.s", "pa·s", "pas", "pa*s", "pa∙s"], "mm2/s": ["mm2/s", "mm²/s"], "cSt": ["cst"], "g/cm3": ["g/cm3", "g/cm³"], "g/mL": ["g/ml", "g / ml", "gm/ml", "g/ ml"], "kg/m3": ["kg/m3", "kg/m³"], "mo": ["month", "months", "monat", "hónap", "mois", "mesi"], "a": ["year", "years", "jahr", "ans", "anni"], "d": ["day", "days", "tage", "nap", "jour", "giorni"], "wk": ["week", "weeks"], "h": ["h", "hour", "hours"], "min": ["min", "minute", "minutes"], "nm": ["nm"], "um": ["µm", "μm", "um", "micron", "microns"], "[CFU]/g": ["cfu/g", "cfu / g", "cfu /g", "ufc/g", "kbe/g", "kbe / g"], "[CFU]/mL": ["cfu/ml", "cfu / ml", "cfu /ml", "ufc/ml", "kbe/ml"], "mg/g": ["mg koh/g", "mg/g"], "mg{KOH}/g": ["mg koh/g", "mgkoh/g", "mg koh / g", "mg koh/ g"], "g/mol": ["g/mol", "da"], "{rpm}": ["rpm"], "/min": ["rpm", "min-1", "/min"], "s-1": ["s-1", "s⁻¹", "1/s"], "mm2/(10.min)": ["mm²/10 min", "mm2/10 min"], "g/L": ["g/l"], "mN/m": ["mn/m"], "g/(100.g)": ["g/100 g", "g/100g", "g i2/100 g"], "meq/kg": ["meq/kg", "meq o2/kg", "méq/kg", "meq o/kg", "meq o /kg"], "deg": ["°", "deg", "degree"], "meq{O2}/kg": ["meq o2/kg", "meqo2/kg", "meq o2 / kg"], "g{I2}/(100.g)": ["g i2/100 g", "gi2/100g", "g i2/100g", "g j/100 g", "g j /100 g"], "uS/cm": ["μs/cm", "us/cm"], "mg/kg/d": ["mg/kg/d", "mg/kg bw/d", "mg/kg bw/day", "mg/kg/day"]},
  "terms": [
    {"key": "mass_fraction", "label": "Mass fraction", "canonical": "%", "units": {"%": 1, "[ppm]": 0.0001, "[ppb]": 1e-07, "mg/kg": 0.0001, "ug/g": 0.0001, "g/kg": 0.1, "g/(100.g)": 1}},
    {"key": "percent", "label": "Percent", "canonical": "%", "units": {"%": 1}},
    {"key": "ph", "label": "Ph", "canonical": "[pH]", "units": {"[pH]": 1}},
    {"key": "temperature", "label": "Temperature", "canonical": "Cel", "units": {"Cel": 1}},
    {"key": "dynamic_viscosity", "label": "Dynamic viscosity", "canonical": "mPa.s", "units": {"mPa.s": 1, "Pa.s": 1000, "cP": 1}},
    {"key": "kinematic_viscosity", "label": "Kinematic viscosity", "canonical": "mm2/s", "units": {"mm2/s": 1, "cSt": 1}},
    {"key": "density", "label": "Density", "canonical": "g/cm3", "units": {"g/cm3": 1, "g/mL": 1, "kg/L": 1, "kg/m3": 0.001}},
    {"key": "bulk_density", "label": "Bulk density", "canonical": "g/L", "units": {"g/L": 1, "kg/m3": 1, "g/cm3": 1000}},
    {"key": "mass_concentration", "label": "Mass concentration", "canonical": "g/L", "units": {"g/L": 1, "mg/mL": 1, "mg/L": 0.001, "g/(100.mL)": 10}},
    {"key": "time", "label": "Time", "canonical": "h", "units": {"h": 1, "min": 0.016666666666666666, "s": 0.0002777777777777778, "d": 24, "wk": 168}},
    {"key": "period", "label": "Period", "canonical": "mo", "units": {"mo": 1, "a": 12, "wk": null, "d": null}},
    {"key": "wavelength", "label": "Wavelength", "canonical": "nm", "units": {"nm": 1}},
    {"key": "particle_size", "label": "Particle size", "canonical": "um", "units": {"um": 1, "nm": 0.001, "mm": 1000}},
    {"key": "dimensionless", "label": "Dimensionless", "canonical": "1", "units": {"1": 1}},
    {"key": "fraction", "label": "Fraction (dimensionless, also as percent)", "canonical": "1", "units": {"1": 1, "%": 0.01}},
    {"key": "count", "label": "Count", "canonical": "1", "units": {"1": 1}},
    {"key": "log_reduction", "label": "Log reduction", "canonical": "1", "units": {"1": 1, "{log10}": 1}},
    {"key": "dose_per_body_mass", "label": "Dose per body mass", "canonical": "mg/kg", "units": {"mg/kg": 1, "g/kg": 1000}},
    {"key": "daily_dose", "label": "Daily dose", "canonical": "mg/kg/d", "units": {"mg/kg/d": 1}},
    {"key": "microbial_count", "label": "Microbial count", "canonical": "[CFU]/g", "units": {"[CFU]/g": 1, "[CFU]/mL": null}},
    {"key": "pressure", "label": "Pressure", "canonical": "Pa", "units": {"Pa": 1, "hPa": 100, "kPa": 1000, "mPa": 0.001}},
    {"key": "surface_tension", "label": "Surface tension", "canonical": "mN/m", "units": {"mN/m": 1}},
    {"key": "spreading", "label": "Spreading", "canonical": "mm2/(10.min)", "units": {"mm2/(10.min)": 1}},
    {"key": "koh_value", "label": "Koh value", "canonical": "mg/g", "units": {"mg/g": 1, "mg{KOH}/g": 1}},
    {"key": "iodine_value", "label": "Iodine value", "canonical": "g/(100.g)", "units": {"g/(100.g)": 1, "g{I2}/(100.g)": 1}},
    {"key": "peroxide_value", "label": "Peroxide value", "canonical": "meq/kg", "units": {"meq/kg": 1, "meq{O2}/kg": 1}},
    {"key": "molar_mass", "label": "Molar mass", "canonical": "g/mol", "units": {"g/mol": 1, "kg/mol": 1000}},
    {"key": "shear_rate", "label": "Shear rate", "canonical": "s-1", "units": {"s-1": 1, "/s": 1}},
    {"key": "rotation_speed", "label": "Rotation speed", "canonical": "/min", "units": {"/min": 1, "{rpm}": 1}},
    {"key": "radiant_exposure", "label": "Radiant exposure", "canonical": "J/cm2", "units": {"J/cm2": 1, "mJ/cm2": 0.001}},
    {"key": "areal_dose", "label": "Areal dose", "canonical": "mg/cm2", "units": {"mg/cm2": 1, "uL/cm2": null}},
    {"key": "frequency", "label": "Frequency", "canonical": "Hz", "units": {"Hz": 1}},
    {"key": "conductivity", "label": "Conductivity", "canonical": "uS/cm", "units": {"uS/cm": 1, "mS/cm": 1000}},
    {"key": "carbon_footprint", "label": "Carbon footprint", "canonical": "kg/kg", "units": {"kg/kg": 1, "kg{CO2e}/kg": 1}},
    {"key": "optical_rotation", "label": "Optical rotation", "canonical": "deg", "units": {"deg": 1}},
    {"key": "specific_extinction", "label": "Specific extinction", "canonical": "1", "units": {"1": 1, "{E1%1cm}": 1}},
    {"key": "tewl", "label": "Tewl", "canonical": "g/m2/h", "units": {"g/m2/h": 1, "g/(m2.h)": 1}}
  ]
}
